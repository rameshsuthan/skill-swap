    C --> POLICY
    R --> POLICY
    H --> POLICY
    GRAPH --> CP[("checkpoints.sqlite<br/>staged plan • approvals • events")]
  end
  subgraph DOMAIN["Separate custom MCP stdio process"]
    TOOLS["Six typed MCP tools"] --> SCOPE["Scope / revision / approval checks"]
