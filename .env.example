GOOGLE_API_KEY=
# GEMINI_API_KEY is accepted as an alias.
GEMINI_MODEL=gemini-3.5-flash-lite
SKILLSWAP_DOMAIN_DB=storage/skillswap.sqlite
SKILLSWAP_CHECKPOINT_DB=storage/checkpoints.sqlite
# Optional hosted Mem0 MCP. Enable only with a configured key.
SKILLSWAP_MEM0_ENABLED=false
MEM0_API_KEY=
# Optional official Pinecone MCP server; requires npm install in integrations/pinecone.
SKILLSWAP_PINECONE_ENABLED=false
PINECONE_INDEX=skillswap-demo
PINECONE_NAMESPACE=global-2026
PINECONE_API_KEY=
